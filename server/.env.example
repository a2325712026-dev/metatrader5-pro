# 复制为 .env 后填写；.env 绝不能提交到 git
BRIDGE_API_KEY=请生成一个长随机字符串
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
# 可选：terminal64.exe 路径（多个终端时指定）
MT5_PATH=
HOST=127.0.0.1
PORT=8000
# 可选：启用 HTTPS（两项必须同时填写；都留空 = 纯 http，行为不变）。相对路径按 .env 所在目录解析。
# 生成自签名证书：mt5-bridge.exe --make-cert 服务器公网IP   （或 python make-cert.py 服务器公网IP）
SSL_CERTFILE=
SSL_KEYFILE=
DEVIATION=20
MAGIC=20261019
# MetaQuotes-Demo 服务器时间相对 UTC 的小时数（留空=自动测算）
MT5_SERVER_UTC_OFFSET_HOURS=
